rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users profile & persistent vault data
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Ledger of transactions & credits
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // User phone verification & sessions
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
    
    // User creations & history
    match /creations/{creationId} {
      allow read, write: if true;
    }

    // Email OTP Verification
    match /email_otps/{email} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
